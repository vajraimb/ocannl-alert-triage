opam-version: "2.0"
synopsis:
  "Tiny transformer text classifier for Google Alerts triage, built on OCANNL"
description:
  "A learning sandbox: a character-level transformer encoder trained with OCANNL (neural_nets_lib) to sort Chinese/English Google Alert headlines into keep / spam / soft-mention / dupe."
maintainer: ["OCANNL learning sandbox"]
authors: ["OCANNL learning sandbox"]
license: "MIT"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.3.0"}
  "neural_nets_lib" {= "1.0.1"}
  "base" {>= "v0.17.0"}
  "stdio"
  "yojson" {>= "2.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
# neural_nets_lib 1.0.1 is not yet published to opam-repository (which stops at 0.6.1), so pin the
# release tag. opam reads pin-depends automatically for `opam install --deps-only .`.
